# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the server (used by Better Auth)
BETTER_AUTH_BASE_URL=http://localhost:3000

# URL the web app uses to reach the server API (baked into the frontend at build time)
VITE_API_URL=http://localhost:3000

# URL of the web app (for CORS)
CORS_ORIGIN=http://localhost:8080
