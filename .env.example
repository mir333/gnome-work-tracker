# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# PostgreSQL connection string (Prisma Cloud Postgres or any PostgreSQL instance)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Public URL of the server (used by Better Auth)
BETTER_AUTH_BASE_URL=http://localhost:3000

# URL the web app uses to reach the server API (baked into the frontend at build time)
VITE_API_URL=http://localhost:3000

# URL of the web app (for CORS)
CORS_ORIGIN=http://localhost:8080

# Passkey configuration (set to your domain in production)
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Work Tracker
